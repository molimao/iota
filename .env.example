# Use your own Supabase project for a fork or separate deployment.
# These are public client configuration values, not service role secrets.
VITE_SUPABASE_PROJECT_ID=your-project-id
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server-side equivalents. Configure these in your hosting environment too.
SUPABASE_PROJECT_ID=your-project-id
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Optional Stripe billing; leave blank to keep subscriptions closed.
# Server-only secrets: never prefix them with VITE_ or commit real values.
SUPABASE_SERVICE_ROLE_KEY=
STRIPE_MODE=test
STRIPE_LIVE_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_ACCOUNT_ID=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_ANNUAL=
# Previous approved Price IDs, comma-separated. Existing subscriptions only.
STRIPE_LEGACY_PRICE_IDS=
STRIPE_PORTAL_CONFIGURATION_ID=
SITE_ORIGIN=http://localhost:8080

# Server-only AES-256 key for optional io.net / Vast.ai account connections.
# Generate with: openssl rand -base64 32
# Never prefix with VITE_, commit the value, or share it with the browser.
WATCH_CONNECTION_ENCRYPTION_KEY=

# Optional Pro daily reports. Remains disabled until the approved mail rollout.
# Use a separate verified sender domain for a digest-capable provider.
DAILY_REPORTS_ENABLED=false
RESEND_API_KEY=
DAILY_REPORTS_CRON_SECRET=
DAILY_REPORTS_CRON_SECRET_PREVIOUS=
DAILY_REPORTS_FROM=noreply@reports.iotahome.site
# Lovable Cloud Jobs authentication; server-only, never VITE_.
LOVABLE_CRON_SECRET=
LOVABLE_CRON_SECRET_PREVIOUS=
